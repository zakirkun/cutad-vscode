{
  "name": "cutad-ai",
  "displayName": "Cutad.AI",
  "description": "AI coding, debugging & planning assistant powered by the CutadAI model gateway. Agent mode with approvals, durable plans, real debugger state, sub-agent specialists, 25 built-in skills, and MCP in both directions.",
  "version": "0.1.0",
  "publisher": "codewithzakir",
  "private": true,
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "coding assistant",
    "mcp",
    "debugging",
    "planning",
    "cutad",
    "llm"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --dev",
    "watch": "node esbuild.mjs --dev --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.mjs\"",
    "spike:host": "node esbuild.mjs --dev && node dist/host-smoke.js",
    "gen:tools": "node scripts/gen-tools-manifest.mjs",
    "package": "node esbuild.mjs && npx @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "cutad.chat",
        "name": "cutad",
        "fullName": "Cutad.AI",
        "description": "AI coding, debugging & planning assistant",
        "isSticky": true,
        "commands": [
          {
            "name": "ask",
            "description": "Ask about the codebase (read-only)"
          },
          {
            "name": "agent",
            "description": "Run a coding task with tools"
          },
          {
            "name": "plan",
            "description": "Create or execute a step-by-step plan"
          },
          {
            "name": "debug",
            "description": "Investigate failures with debugger & test state"
          },
          {
            "name": "skills",
            "description": "List installed skills"
          },
          {
            "name": "mcp",
            "description": "Show MCP server status"
          },
          {
            "name": "help",
            "description": "Show Cutad.AI help"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "cutad.setApiKey",
        "title": "Cutad.AI: Set API Key"
      },
      {
        "command": "cutad.testConnection",
        "title": "Cutad.AI: Test Connection"
      },
      {
        "command": "cutad.selectModel",
        "title": "Cutad.AI: Select Model"
      },
      {
        "command": "cutad.showDiagnostics",
        "title": "Cutad.AI: Show Diagnostics"
      },
      {
        "command": "cutad.openConfig",
        "title": "Cutad.AI: Open Config File (~/.cutad/config.json)"
      },
      {
        "command": "cutad.openPlan",
        "title": "Cutad.AI: Open Plan"
      },
      {
        "command": "cutad.startMcpServer",
        "title": "Cutad.AI: Start MCP Server"
      },
      {
        "command": "cutad.reconnectMcp",
        "title": "Cutad.AI: Reconnect MCP Servers"
      }
    ],
    "configuration": {
      "title": "Cutad.AI",
      "properties": {
        "cutad.baseUrl": {
          "type": "string",
          "default": "https://ai.cutad.web.id/v1",
          "description": "CutadAI gateway base URL."
        },
        "cutad.model": {
          "type": "string",
          "default": "",
          "description": "Default model id (empty = pick from GET /v1/models)."
        },
        "cutad.reasoning.show": {
          "type": "boolean",
          "default": true,
          "description": "Show model reasoning/thinking in chat."
        },
        "cutad.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in anonymous telemetry (event names only, never code or prompts)."
        },
        "cutad.mcp.port": {
          "type": "number",
          "default": 3987,
          "description": "Localhost port for the in-editor MCP server (Streamable HTTP)."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "cutad_read_file",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "read_file",
        "displayName": "Read File",
        "modelDescription": "Read a text file from the workspace. Returns numbered lines. Optionally restrict to a line range (1-based). Use before editing a file.",
        "userDescription": "Read a workspace file",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path"
            },
            "startLine": {
              "description": "First line (1-based)",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "endLine": {
              "description": "Last line (1-based, inclusive)",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_list_dir",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "list_dir",
        "displayName": "List Directory",
        "modelDescription": "List files and directories at a workspace path (defaults to the workspace root).",
        "userDescription": "List a directory",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "description": "Workspace-relative directory path (default: root)",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_get_workspace_tree",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "get_workspace_tree",
        "displayName": "Workspace Tree",
        "modelDescription": "Show a bounded tree of the workspace folders (useful for orientation).",
        "userDescription": "Show workspace structure",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "depth": {
              "description": "Max depth (default 2)",
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_search_text",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "search_text",
        "displayName": "Search Text",
        "modelDescription": "Search file contents in the workspace for a literal string or regular expression. Returns file:line matches.",
        "userDescription": "Search for text in the workspace",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Literal text or JavaScript regular expression"
            },
            "maxResults": {
              "description": "Max matches (default 50)",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "glob": {
              "description": "Optional file extension filter, e.g. '.ts' or '.ts,.js'",
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_find_files",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "find_files",
        "displayName": "Find Files",
        "modelDescription": "Find files by name pattern (substring or glob-like, e.g. '*.test.ts', 'config'). Returns workspace-relative paths. Faster than search_text when you only need paths.",
        "userDescription": "Find files by name",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Name pattern: substring or glob with * (e.g. '*.test.ts')"
            },
            "maxResults": {
              "description": "Max results (default 100)",
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          "required": [
            "pattern"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_apply_patch",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "apply_patch",
        "displayName": "Apply Patch",
        "modelDescription": "Replace an exact text block in a file. oldText must match the file content exactly (including whitespace) and must be unique. Use read_file first to copy the exact text. Prefer small targeted edits over rewriting whole files.",
        "userDescription": "Edit a file (exact text replacement)",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path"
            },
            "oldText": {
              "type": "string",
              "description": "Exact existing text to replace"
            },
            "newText": {
              "type": "string",
              "description": "Replacement text (empty string deletes the block)"
            }
          },
          "required": [
            "path",
            "oldText",
            "newText"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_write_file",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "write_file",
        "displayName": "Write File",
        "modelDescription": "Create or overwrite a file with the given content. For edits to existing files prefer apply_patch.",
        "userDescription": "Write a file (create or overwrite)",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path"
            },
            "content": {
              "type": "string",
              "description": "Full file content"
            }
          },
          "required": [
            "path",
            "content"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_git_status",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "git_status",
        "displayName": "Git Status",
        "modelDescription": "Show the working tree status (branch and changed files) as porcelain output.",
        "userDescription": "Show git status",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_git_diff",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "git_diff",
        "displayName": "Git Diff",
        "modelDescription": "Show unstaged (or staged) changes as a unified diff.",
        "userDescription": "Show git diff",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "staged": {
              "description": "Show staged changes (default false)",
              "type": "boolean"
            },
            "path": {
              "description": "Limit diff to this path",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_run_command",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "run_command",
        "displayName": "Run Command",
        "modelDescription": "Run a shell command in a terminal and capture its output. Use for builds, tests, and CLI tools. Avoid long-running processes (dev servers).",
        "userDescription": "Run a terminal command",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "description": "The exact shell command to run"
            },
            "cwd": {
              "description": "Working directory (default: workspace root)",
              "type": "string"
            },
            "timeoutSeconds": {
              "description": "Timeout (default 120)",
              "type": "integer",
              "minimum": 5,
              "maximum": 300
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_run_tests",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "run_tests",
        "displayName": "Run Tests",
        "modelDescription": "Run the project's test command (auto-detected from package.json or overridable) and return a parsed summary with failure details. Use to verify changes or reproduce reported failures.",
        "userDescription": "Run the project test suite",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "description": "Override test command (default: auto-detect npm test / pytest / cargo test)",
              "type": "string"
            },
            "filter": {
              "description": "Test name filter (passed to the runner when supported)",
              "type": "string"
            },
            "timeoutSeconds": {
              "description": "Timeout (default 300)",
              "type": "integer",
              "minimum": 10,
              "maximum": 600
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_fetch_url",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "fetch_url",
        "displayName": "Fetch URL",
        "modelDescription": "Fetch a URL (documentation, API reference, changelog) and return its text content, stripped of HTML. Use for looking up external documentation when the installed sources are not enough.",
        "userDescription": "Fetch a web page (documentation lookup)",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "HTTP(S) URL to fetch"
            },
            "maxChars": {
              "description": "Max characters (default 30000)",
              "type": "integer",
              "minimum": 1000,
              "maximum": 100000
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_get_diagnostics",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "get_diagnostics",
        "displayName": "Get Diagnostics",
        "modelDescription": "Get current errors and warnings from the language servers (Problems panel). Optionally filter by file path.",
        "userDescription": "Read workspace diagnostics",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "description": "Filter to a workspace-relative file path",
              "type": "string"
            },
            "severity": {
              "description": "Filter by severity",
              "type": "string",
              "enum": [
                "error",
                "warning"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_get_open_editors",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "get_open_editors",
        "displayName": "Get Open Editors",
        "modelDescription": "List currently open editor tabs with their paths.",
        "userDescription": "List open editor tabs",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_get_selection",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "get_selection",
        "displayName": "Get Selection",
        "modelDescription": "Get the text currently selected in the active editor (or the full file path if no selection).",
        "userDescription": "Read the active editor selection",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_get_debug_state",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "get_debug_state",
        "displayName": "Get Debug State",
        "modelDescription": "Read the current debugger state: active session, paused threads, stack frames, scopes, and variables. Use when the debugger is stopped at a breakpoint to understand why. Returns empty-state message when no session is active or running.",
        "userDescription": "Read the debugger state (stack, variables)",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "threadId": {
              "description": "DAP thread id (default: first thread)",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "frameIndex": {
              "description": "Stack frame index (default: 0 = innermost)",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxVariables": {
              "description": "Max variables per scope (default 30)",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_list_breakpoints",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "list_breakpoints",
        "displayName": "List Breakpoints",
        "modelDescription": "List all currently set breakpoints with file and line.",
        "userDescription": "List breakpoints",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_set_breakpoint",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "set_breakpoint",
        "displayName": "Set Breakpoint",
        "modelDescription": "Set a breakpoint at a file and line (1-based). Optionally with a condition expression.",
        "userDescription": "Set a breakpoint",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path"
            },
            "line": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Line number (1-based)"
            },
            "condition": {
              "description": "Conditional expression, e.g. 'userId === null'",
              "type": "string"
            }
          },
          "required": [
            "path",
            "line"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_remove_breakpoint",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "remove_breakpoint",
        "displayName": "Remove Breakpoint",
        "modelDescription": "Remove the breakpoint at a file and line (1-based).",
        "userDescription": "Remove a breakpoint",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path"
            },
            "line": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Line number (1-based)"
            }
          },
          "required": [
            "path",
            "line"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "cutad_launch_debug",
        "tags": [
          "cutad"
        ],
        "toolReferenceName": "launch_debug",
        "displayName": "Launch Debug Session",
        "modelDescription": "Start a debug session from a launch configuration. Use with no argument to list available configurations first.",
        "userDescription": "Start a debug session",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "configuration": {
              "description": "Launch configuration name from launch.json",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    ]
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.69",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.5.0",
    "@langchain/langgraph-checkpoint": "1.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ai": "7.0.141",
    "langchain": "1.5.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
